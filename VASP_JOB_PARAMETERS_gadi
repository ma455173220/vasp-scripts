CHECK_AUTO_STOP (){

	cd $PBS_O_WORKDIR
	COUNTER=0
	COUNTER_MAX=288
	while [ $COUNTER -le $COUNTER_MAX ]; do
		if [ -a AUTOSTOP ] ; then
			AUTO_STOP &
			exit
		else
			sleep 600s
			(( COUNTER++ ))
		fi
	done
}

AUTO_STOP (){

	cd $PBS_O_WORKDIR
	SLEEP_TIME=`cat AUTOSTOP`
	sleep $SLEEP_TIME
	cp /home/561/hm1876/STOPCAR $PBS_O_WORKDIR
	rm AUTOSTOP
}

get_incar_tag() {
	local key="$1"
	awk -v key="$key" '
		{
			line=$0
			sub(/[#!].*/, "", line)
			n=split(line, parts, ";")
			for (i=1; i<=n; i++) {
				part=parts[i]
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", part)
				if (part ~ "^" key "[[:space:]]*=") {
					sub("^[^=]*=[[:space:]]*", "", part)
					split(part, value, /[[:space:]]+/)
					print value[1]
					exit
				}
			}
		}
	' INCAR
}

check_completion() {
	local outcar_file="$PWD/OUTCAR"
	local mode_check="$(get_incar_tag IBRION || true)"

	if [[ ! -f "$outcar_file" ]]; then
		echo "$(date): Job failed - OUTCAR not found in $PWD" >> ~/vasp_fail_log
		return 1
	fi

	if ! grep -q "Total CPU time used" "$outcar_file"; then
		echo "$(date): Job failed - Job did not complete normally in $PWD" >> ~/vasp_fail_log
		return 1
	fi

	if [[ "$mode_check" =~ ^(0|5|6|7|8)$ ]]; then
		# MD (IBRION=0) or finite-difference/DFPT (IBRION=5-8): no ionic convergence message
		if ! grep -q "EDIFF is reached" "$outcar_file"; then
			echo "$(date): Job failed - IBRION=$mode_check did not meet criteria in $PWD" >> ~/vasp_fail_log
			return 1
		fi
	elif [[ -z "$mode_check" ]] || [[ "$mode_check" != "-1" ]]; then
		# Optimization job
		if ! grep -q "reached required accuracy" "$outcar_file" || ! grep -q "EDIFF is reached" "$outcar_file"; then
			echo "$(date): Job failed - Optimization did not converge in $PWD" >> ~/vasp_fail_log
			return 1
		fi
	else
		# SCF job
		if ! grep -q "EDIFF is reached" "$outcar_file"; then
			echo "$(date): Job failed - SCF did not converge in $PWD" >> ~/vasp_fail_log
			return 1
		fi
	fi

	return 0
}


final_act (){
	# Back up outputs once for every job type (previously ran twice for relaxations)
	rename_files
	remove_files
	if check_completion; then
		log_report "SUCCESS"
	else
		log_report "FAILED"
		exit 1
	fi
	if [ -e AECCAR2 ] ; then
		bader_cal
	fi

	print_band_gap
	print_dos

	if [ -e VASP_AUTO_SUBMISSION ] ; then
		job_auto_submission
	fi
	exit

}

