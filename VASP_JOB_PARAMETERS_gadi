# Gadi (PBS) end-of-job hook, sourced by job scripts; implementation: VASP_JOB_PARAMETERS (next to this file, else PATH)
VJP_SITE=gadi; _vjp="$(dirname "${BASH_SOURCE[0]}")/VASP_JOB_PARAMETERS"; [ -f "$_vjp" ] || _vjp=$(command -v VASP_JOB_PARAMETERS)
if [ -n "$_vjp" ]; then source "$_vjp"; else echo "VASP_JOB_PARAMETERS not found next to ${BASH_SOURCE[0]} or on PATH; end-of-job hook disabled" >&2; fi
