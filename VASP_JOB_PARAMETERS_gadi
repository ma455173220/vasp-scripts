#!/bin/bash

REMOVE_RENAME_FILES="CHG REPORT" # vaspout.h5
COPY_RENAME_FILES="CONTCAR OSZICAR OUTCAR XDATCAR EIGENVAL" 
BACKUP_INPUT_FILES="INCAR POSCAR"

# Directory of this file (it is sourced from job scripts, so $0 is not this file)
VASP_JOB_PARAMETERS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-.}")" 2>/dev/null && pwd)"

# find_tool <old hardcoded path>: that path if it exists, else the copy next to
# this file, else the same name on PATH; prints nothing if not found
find_tool () {
	local name=$(basename "$1")
	if [ -f "$1" ] ; then
		echo "$1"
	elif [ -f "$VASP_JOB_PARAMETERS_DIR/$name" ] ; then
		echo "$VASP_JOB_PARAMETERS_DIR/$name"
	else
		command -v "$name" 2>/dev/null
	fi
}

job_auto_submission () {
	FUNCTION_CHOSEN=`grep "\.T\." VASP_AUTO_SUBMISSION |  awk -F '=|#' '{print $2}'`
		FUNCTION_CHOSEN_NO_SPACE=`echo $FUNCTION_CHOSEN`
	if [ "$FUNCTION_CHOSEN" ] ; then
		local auto_script=$(find_tool /home/561/hm1876/vasp_scripts_self_created/${FUNCTION_CHOSEN_NO_SPACE}.sh)
		if [ -n "$auto_script" ] ; then
			sh "$auto_script" 1> /dev/null
		else
			echo "${FUNCTION_CHOSEN_NO_SPACE}.sh not found, vasp_auto_submission skipped"
		fi
		sed -i 's/\.T\./\.F\./' VASP_AUTO_SUBMISSION
	else
		echo "No vasp_auto_submission chosen"
	fi
}

bader_cal (){

	local chgsum=$(find_tool /home/561/hm1876/vtstscripts/chgsum.pl)
	local bader=$(find_tool /home/561/hm1876/.local/bin/bader)
	if [ -z "$chgsum" ] || [ -z "$bader" ] ; then
		echo "chgsum.pl or bader not found, Bader analysis skipped"
		return
	fi
	"$chgsum"  AECCAR0 AECCAR2
	"$bader" CHGCAR -ref CHGCAR_sum 
	rm -rf $PBS_O_WORKDIR/AECCAR* $PBS_O_WORKDIR/CHGCAR_sum
}

