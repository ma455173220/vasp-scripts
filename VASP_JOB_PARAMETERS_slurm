#!/bin/bash

REMOVE_RENAME_FILES="CHG REPORT" # vaspout.h5
COPY_RENAME_FILES="CONTCAR OSZICAR OUTCAR XDATCAR EIGENVAL" 
BACKUP_INPUT_FILES="INCAR POSCAR"

# Directory of this file (it is sourced from job scripts, so $0 is not this file)
VASP_JOB_PARAMETERS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-.}")" 2>/dev/null && pwd)"

# find_tool <old hardcoded path>: that path if it exists, else the copy next to
# this file, else the same name on PATH; prints nothing if not found
find_tool () {
    local name=$(basename "$1")
    if [ -f "$1" ] ; then
        echo "$1"
    elif [ -f "$VASP_JOB_PARAMETERS_DIR/$name" ] ; then
        echo "$VASP_JOB_PARAMETERS_DIR/$name"
    else
        command -v "$name" 2>/dev/null
    fi
}

bader_cal (){
    local chgsum=$(find_tool /software/projects/pawsey0328/hma/scripts/vtstscripts-1035/chgsum.pl)
    local bader=$(find_tool /software/projects/pawsey0328/hma/scripts/vasp-scripts/bader)
    if [ -z "$chgsum" ] || [ -z "$bader" ] ; then
        echo "chgsum.pl or bader not found, Bader analysis skipped"
        return
    fi
    "$chgsum"  AECCAR0 AECCAR2
    "$bader" CHGCAR -ref CHGCAR_sum 
    rm -rf ${SLURM_SUBMIT_DIR}/AECCAR* ${SLURM_SUBMIT_DIR}/CHGCAR_sum
}

log_report (){
    local status="${1:-SUCCESS}"   # 默认成功，失败时传入 "FAILED"
    echo -e "\n------------------------------------------------------" >> ~/vasp_job_log
    # if [[ "$status" == "FAILED" ]]; then
    #     echo -e "\n!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> ~/vasp_job_log
    #     echo -e "!!                                                  !!" >> ~/vasp_job_log
    #     echo -e "!!                  JOB FAILED !!!                  !!" >> ~/vasp_job_log
    #     echo -e "!!                                                  !!" >> ~/vasp_job_log
    #     echo -e "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!" >> ~/vasp_job_log
    # fi
    echo -e "Job finished at \c" >> ~/vasp_job_log && date >> ~/vasp_job_log
    echo -e "PATH: ${SLURM_SUBMIT_DIR}" >> ~/vasp_job_log
    echo -e "STATUS: ${status}" >> ~/vasp_job_log
    echo -e "------------------------------------------------------" >> ~/vasp_job_log
}

backup_input_files () {                               
    for ii in $BACKUP_INPUT_FILES ; do       
        cp $ii ${JOBNAME}_${ii}         
    done                                    
}                                               

rename_files () {
    #        for i in $MOVE_RENAME_FILES ; do
    #                mv $i ${JOBNAME}_${i}
    #        done
    for ii in $COPY_RENAME_FILES ; do
        cp $ii ${JOBNAME}_${ii}
    done
    if [ -s CONTCAR ] ; then
        cp CONTCAR POSCAR
    fi
}

remove_files (){
    for ii in $REMOVE_RENAME_FILES ; do
        if [ "$ii" = "REPORT" ] && keep_report ; then
            continue
        fi
        rm -f $ii
    done
}

print_band_gap (){
    echo 911 | vaspkit > band_gap
    echo -e "211\n" | vaspkit
    # python3 /home/561/hm1876/.local/bin/band_vaspkit.py
}

print_dos (){
    echo -e "111\n1" | vaspkit > TDOS_log
    echo -e "113\nall\n1" | vaspkit > PDOS_log
    echo -e "116" | vaspkit > LDOS_log
}


get_incar_tag() {
    local key="$1"
    awk -v key="$key" '
        {
            line=$0
            sub(/[#!].*/, "", line)
            n=split(line, parts, ";")
            for (i=1; i<=n; i++) {
                part=parts[i]
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", part)
                if (toupper(part) ~ "^" toupper(key) "[[:space:]]*=") {
                    sub("^[^=]*=[[:space:]]*", "", part)
                    split(part, value, /[[:space:]]+/)
                    print value[1]
                    exit
                }
            }
        }
    ' INCAR
}

# NSW missing or <= 0: static (single-point) run
is_static_run() {
    local nsw="$(get_incar_tag NSW || true)"
    [[ -z "$nsw" ]] && return 0
    [[ "$nsw" =~ ^-?[0-9]+$ ]] || return 1
    (( nsw <= 0 ))
}

# REPORT holds MD / constrained-MD (blue-moon, slow-growth) / ML force-field data
keep_report() {
    local mdalgo="$(get_incar_tag MDALGO || true)"
    local lmlff="$(get_incar_tag ML_LMLFF || true)"
    local mlmode="$(get_incar_tag ML_MODE || true)"
    [[ -n "$mdalgo" && "$mdalgo" != "0" ]] && return 0
    [[ -f ICONST ]] && return 0
    [[ "$lmlff" =~ ^\.?[Tt] ]] && return 0
    [[ -n "$mlmode" ]] && return 0
    return 1
}

check_completion() {
    local outcar_file="$PWD/OUTCAR"
    local mode_check="$(get_incar_tag IBRION || true)"
    local nsw="$(get_incar_tag NSW || true)"

    if [[ ! -f "$outcar_file" ]]; then
        echo "$(date): Job failed - OUTCAR not found in $PWD" >> ~/vasp_fail_log
        return 1
    fi

    if ! grep -q "Total CPU time used" "$outcar_file"; then
        echo "$(date): Job failed - Job did not complete normally in $PWD" >> ~/vasp_fail_log
        return 1
    fi

    # Job type (same table in VASP_JOB_PARAMETERS_gadi and _slurm):
    #   NSW missing or <= 0           -> static run: EDIFF only
    #   IBRION 0/5/6/7/8 (or no IBRION
    #   with NSW > 0, VASP default 0) -> MD / finite differences / DFPT: EDIFF only
    #   IBRION 1/2/3/44               -> optimisation / IDM: "reached required accuracy"
    #   anything else (-1, 11, ...)   -> EDIFF only
    if is_static_run; then
        if ! grep -q "EDIFF is reached" "$outcar_file"; then
            echo "$(date): Job failed - SCF did not converge in $PWD" >> ~/vasp_fail_log
            return 1
        fi
    elif [[ "$mode_check" =~ ^(1|2|3|44)$ ]]; then
        if ! grep -q "reached required accuracy" "$outcar_file" || ! grep -q "EDIFF is reached" "$outcar_file"; then
            echo "$(date): Job failed - Optimization did not converge in $PWD" >> ~/vasp_fail_log
            return 1
        fi
    else
        if ! grep -q "EDIFF is reached" "$outcar_file"; then
            echo "$(date): Job failed - IBRION=${mode_check:-default} (NSW=$nsw) did not meet criteria in $PWD" >> ~/vasp_fail_log
            return 1
        fi
    fi

    return 0
}

final_act (){
    MODE_CHECK="$(get_incar_tag IBRION || true)"
    if [ -z "$MODE_CHECK" ] || [ "$MODE_CHECK" != "-1" ]; then
    	rename_files
    fi
    remove_files
    if check_completion; then
        log_report "SUCCESS"
    else
        log_report "FAILED"
        exit 1
    fi
    # band gap / DOS post-processing only for static runs (not relaxations or MD)
    if is_static_run ; then
        print_band_gap
        print_dos
    fi
    if [ -e AECCAR2 ] ; then
        bader_cal
    fi
    exit

}

MODE_CHECK="$(get_incar_tag IBRION || true)"
if [ -z "$MODE_CHECK" ] || [ "$MODE_CHECK" != "-1" ]; then
    backup_input_files
fi
trap 'final_act' EXIT
